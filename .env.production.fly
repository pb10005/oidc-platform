# Fly.io Production Environment Configuration

# Database (will be set via Fly secrets)
# DATABASE_URL will be automatically set when attaching Fly Postgres

# Security (will be set via Fly secrets)
# SECRET_KEY will be set via fly secrets set
ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=30
REFRESH_TOKEN_EXPIRE_DAYS=7

# Server
HOST=0.0.0.0
PORT=8000
DEBUG=false

# Application
APP_TITLE=OIDC Authentication Server
APP_DESCRIPTION=OpenID Connect compliant authentication and authorization server
APP_VERSION=1.0.0

# OIDC (will be set via Fly secrets for ISSUER)
# ISSUER will be set to https://your-app-name.fly.dev
SUPPORTED_SCOPES=["openid", "profile", "email"]
SUPPORTED_RESPONSE_TYPES=["code"]
SUPPORTED_RESPONSE_MODES=["query"]
SUPPORTED_GRANT_TYPES=["authorization_code", "refresh_token"]
SUPPORTED_SUBJECT_TYPES=["public"]
SUPPORTED_ID_TOKEN_SIGNING_ALGS=["HS256"]
SUPPORTED_TOKEN_ENDPOINT_AUTH_METHODS=["client_secret_post", "client_secret_basic"]
SUPPORTED_CODE_CHALLENGE_METHODS=["S256", "plain"]
SUPPORTED_CLAIMS=["sub", "iss", "aud", "exp", "iat", "auth_time", "name", "given_name", "family_name", "email", "email_verified"]

# Sample Client Configuration
SAMPLE_CLIENT_ID=sample-client
SAMPLE_CLIENT_SECRET=sample-secret
SAMPLE_CLIENT_NAME=Sample OIDC Client
SAMPLE_CLIENT_TYPE=confidential

# Client Example Configuration
CLIENT_EXAMPLE_PORT=3000

# CORS (will be set via Fly secrets for production domains)
# ALLOWED_ORIGINS will be set to production client domains

# UI Configuration
ALERT_AUTO_HIDE_SECONDS=5
FORM_LOADING_TIMEOUT_SECONDS=10

# Production specific settings
SECURE_COOKIES=true
CORS_ALLOW_CREDENTIALS=true
